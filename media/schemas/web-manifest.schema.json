{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatgpt-lib.local/schemas/web-manifest.schema.json",
  "title": "Media web manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "default_target",
    "targets",
    "vocabulary",
    "profiles",
    "taste_contexts",
    "recommendations",
    "works"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "default_target": {"type": ["string", "null"]},
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewers", "groups"],
      "properties": {
        "viewers": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "groups": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          }
        }
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "label_ru"],
        "properties": {
          "kind": {"type": "string"},
          "label_ru": {"type": "string"}
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {"type": "object"}
    },
    "taste_contexts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": ["schema_version", "target", "profile", "representative", "recent_feedback", "exclusions"],
        "properties": {
          "schema_version": {"const": 1},
          "target": {"type": "string"},
          "profile": {
            "type": "object",
            "additionalProperties": true,
            "required": ["explicit_preferences", "inferred_preferences", "rules", "constraints", "strongest_affinities", "summary"],
            "properties": {
              "explicit_preferences": {"type": "array"},
              "inferred_preferences": {"type": "array"},
              "rules": {"type": "array"},
              "constraints": {"type": "array"},
              "strongest_affinities": {"type": "array"},
              "summary": {"type": "object"}
            }
          },
          "representative": {
            "type": "object",
            "additionalProperties": false,
            "required": ["high", "low"],
            "properties": {
              "high": {"type": "array"},
              "low": {"type": "array"}
            }
          },
          "recent_feedback": {"type": "array"},
          "exclusions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["watched", "not_interested"],
            "properties": {
              "watched": {"type": "array", "items": {"type": "string"}},
              "not_interested": {"type": "array", "items": {"type": "string"}}
            }
          },
          "couple": {
            "type": "object",
            "additionalProperties": false,
            "required": ["members", "agreements", "disagreements"],
            "properties": {
              "members": {"type": "array", "items": {"type": "string"}},
              "agreements": {"type": "array"},
              "disagreements": {"type": "array"}
            }
          }
        }
      }
    },
    "recommendations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "request", "candidates"],
        "properties": {
          "target": {"type": "string"},
          "request": {
            "type": "object",
            "additionalProperties": true
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "not": {"required": ["score"]},
              "additionalProperties": true
            }
          }
        }
      }
    },
    "works": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "identity",
          "metadata",
          "viewer_signals",
          "group_signals",
          "interest",
          "traits",
          "semantic_fingerprint",
          "collections",
          "provenance"
        ],
        "properties": {
          "id": {"type": "string"},
          "identity": {"type": "object", "additionalProperties": true},
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": ["external"],
            "properties": {
              "external": {"type": "object", "additionalProperties": true}
            }
          },
          "viewer_signals": {"type": "object", "additionalProperties": true},
          "group_signals": {"type": "object", "additionalProperties": true},
          "interest": {"type": "object", "additionalProperties": true},
          "traits": {
            "type": "array",
            "items": {"type": "string"}
          },
          "semantic_fingerprint": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["term", "source", "confidence"],
              "properties": {
                "term": {"type": "string"},
                "source": {"type": "string"},
                "confidence": {"type": "string"}
              }
            }
          },
          "collections": {
            "type": "array",
            "items": {"type": "string"}
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["created_at", "updated_at"],
            "properties": {
              "created_at": {"type": ["string", "null"]},
              "updated_at": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  }
}
