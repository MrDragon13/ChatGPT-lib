{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatgpt-lib.local/schemas/web-manifest.schema.json",
  "title": "Media web manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "default_target",
    "targets",
    "vocabulary",
    "profiles",
    "taste_contexts",
    "recommendations",
    "works"
  ],
  "$defs": {
    "similarityOther": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "title_original", "title_ru", "year"],
          "properties": {
            "kind": {"const": "canonical"},
            "id": {"type": "string", "minLength": 1},
            "title_original": {"type": ["string", "null"]},
            "title_ru": {"type": ["string", "null"]},
            "year": {"type": ["integer", "null"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "provider", "id", "title", "year"],
          "properties": {
            "kind": {"const": "external"},
            "provider": {"enum": ["tmdb", "imdb"]},
            "media_type": {"enum": ["movie", "tv"]},
            "id": {"type": ["integer", "string"]},
            "title": {"type": "string", "minLength": 1},
            "year": {"type": ["integer", "null"]}
          }
        }
      ]
    },
    "workSimilarity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["other", "terms", "note", "updated_at", "provenance"],
      "properties": {
        "other": {"$ref": "#/$defs/similarityOther"},
        "terms": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "note": {"type": ["string", "null"]},
        "updated_at": {"type": "string", "minLength": 1},
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source"],
          "properties": {"source": {"const": "explicit"}}
        }
      }
    }
  },
  "properties": {
    "schema_version": {"const": 3},
    "default_target": {"type": ["string", "null"]},
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewers", "groups"],
      "properties": {
        "viewers": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "groups": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          }
        }
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "label_ru"],
        "properties": {
          "kind": {"type": "string"},
          "label_ru": {"type": "string"}
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {"type": "object"}
    },
    "taste_contexts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": ["schema_version", "target", "profile", "representative", "recent_feedback", "exclusions"],
        "properties": {
          "schema_version": {"const": 1},
          "target": {"type": "string"},
          "profile": {
            "type": "object",
            "additionalProperties": true,
            "required": ["explicit_preferences", "inferred_preferences", "rules", "constraints", "strongest_affinities", "summary"],
            "properties": {
              "explicit_preferences": {"type": "array"},
              "inferred_preferences": {"type": "array"},
              "rules": {"type": "array"},
              "constraints": {"type": "array"},
              "strongest_affinities": {"type": "array"},
              "summary": {"type": "object"}
            }
          },
          "representative": {
            "type": "object",
            "additionalProperties": false,
            "required": ["high", "low"],
            "properties": {
              "high": {"type": "array"},
              "low": {"type": "array"}
            }
          },
          "recent_feedback": {"type": "array"},
          "exclusions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["watched", "not_interested"],
            "properties": {
              "watched": {"type": "array", "items": {"type": "string"}},
              "not_interested": {"type": "array", "items": {"type": "string"}}
            }
          },
          "couple": {
            "type": "object",
            "additionalProperties": false,
            "required": ["members", "agreements", "disagreements", "term_signals"],
            "properties": {
              "members": {"type": "array", "items": {"type": "string"}},
              "agreements": {"type": "array"},
              "disagreements": {"type": "array"},
              "term_signals": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["term", "members", "status"],
                  "properties": {
                    "term": {"type": "string", "minLength": 1},
                    "members": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["direction", "confidence", "evidence_count"],
                        "properties": {
                          "direction": {"enum": ["positive", "negative", null]},
                          "confidence": {"type": ["string", "null"]},
                          "evidence_count": {"type": "integer", "minimum": 0}
                        }
                      }
                    },
                    "status": {"enum": ["agreement", "disagreement", "insufficient"]}
                  }
                }
              }
            }
          }
        }
      }
    },
    "recommendations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "request", "coverage", "limitations", "candidates"],
        "properties": {
          "target": {"type": "string"},
          "request": {
            "type": "object",
            "additionalProperties": true
          },
          "coverage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pool_total",
              "pool_with_fingerprint",
              "pool_with_personalized_basis",
              "pool_fallback",
              "returned_total",
              "returned_with_fingerprint",
              "returned_with_personalized_basis",
              "returned_fallback"
            ],
            "properties": {
              "pool_total": {"type": "integer", "minimum": 0},
              "pool_with_fingerprint": {"type": "integer", "minimum": 0},
              "pool_with_personalized_basis": {"type": "integer", "minimum": 0},
              "pool_fallback": {"type": "integer", "minimum": 0},
              "returned_total": {"type": "integer", "minimum": 0},
              "returned_with_fingerprint": {"type": "integer", "minimum": 0},
              "returned_with_personalized_basis": {"type": "integer", "minimum": 0},
              "returned_fallback": {"type": "integer", "minimum": 0}
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "enum": [
                "partial_semantic_coverage",
                "fallback_candidates_present",
                "no_personalized_candidates"
              ]
            },
            "uniqueItems": true
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "not": {"required": ["score"]},
              "additionalProperties": true
            }
          }
        }
      }
    },
    "works": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "identity",
          "metadata",
          "viewer_signals",
          "group_signals",
          "interest",
          "traits",
          "semantic_fingerprint",
          "similarities",
          "collections",
          "provenance"
        ],
        "properties": {
          "id": {"type": "string"},
          "identity": {"type": "object", "additionalProperties": true},
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": ["external"],
            "properties": {
              "external": {"type": "object", "additionalProperties": true}
            }
          },
          "viewer_signals": {"type": "object", "additionalProperties": true},
          "group_signals": {"type": "object", "additionalProperties": true},
          "interest": {"type": "object", "additionalProperties": true},
          "traits": {
            "type": "array",
            "items": {"type": "string"}
          },
          "semantic_fingerprint": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["term", "source", "confidence"],
              "properties": {
                "term": {"type": "string"},
                "source": {"type": "string"},
                "confidence": {"type": "string"}
              }
            }
          },
          "similarities": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {"$ref": "#/$defs/workSimilarity"}
            }
          },
          "collections": {
            "type": "array",
            "items": {"type": "string"}
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["created_at", "updated_at"],
            "properties": {
              "created_at": {"type": ["string", "null"]},
              "updated_at": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  }
}
