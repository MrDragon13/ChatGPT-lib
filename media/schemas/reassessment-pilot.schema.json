{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatgpt-lib.local/schemas/reassessment-pilot.schema.json",
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "historicalExposure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timing", "before_finalization"],
      "properties": {
        "timing": {"enum": ["none", "before_initial_response", "after_initial_response"]},
        "before_finalization": {"type": "boolean"}
      }
    },
    "frozenItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewing_status", "stratum", "order_key", "order_rank", "pre_pilot_feedback_digest"],
      "properties": {
        "viewing_status": {"enum": ["watched", "partial", "dropped", "forgotten"]},
        "stratum": {"enum": ["special", "low", "medium_low", "central", "high", "unrated_viewed"]},
        "order_key": {"$ref": "#/$defs/digest"},
        "order_rank": {"type": "integer", "minimum": 0},
        "pre_pilot_feedback_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "lifecycleItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["pending", "in_progress", "reviewed", "deferred"]},
        "session_id": {"type": "string", "minLength": 36, "maxLength": 36},
        "reserved_at": {"type": "string", "minLength": 1},
        "pre_review_feedback_digest": {"$ref": "#/$defs/digest"},
        "pre_review_work_file_digest": {"$ref": "#/$defs/digest"},
        "outcome": {"enum": ["changed", "confirmed_unchanged", "deferred"]},
        "historical_exposure": {"$ref": "#/$defs/historicalExposure"},
        "reviewed_at": {"type": "string", "minLength": 1},
        "operation_id": {"type": "string", "minLength": 36, "maxLength": 36}
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": true,
      "required": ["session_id", "reserved_work_ids", "status", "opened_at"],
      "properties": {
        "session_id": {"type": "string", "minLength": 36, "maxLength": 36},
        "reserved_work_ids": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "status": {"enum": ["open", "closed"]},
        "opened_at": {"type": "string", "minLength": 1},
        "closed_at": {"type": "string", "minLength": 1}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pilot_id",
    "pilot_status",
    "target",
    "base_revision",
    "baseline_path",
    "baseline_schema_version",
    "baseline_canonical_input_digest",
    "frozen_cohort",
    "items",
    "sessions",
    "scheduled_reanalysis"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "pilot_id": {"const": "primary-legacy-v1"},
    "pilot_status": {"enum": ["active", "completed"]},
    "target": {"const": "primary"},
    "base_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "baseline_path": {"type": "string", "minLength": 1},
    "baseline_schema_version": {"type": "integer", "minimum": 1},
    "baseline_canonical_input_digest": {"$ref": "#/$defs/digest"},
    "frozen_cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cohort_revision", "work_ids", "items"],
      "properties": {
        "cohort_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "work_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "items": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/frozenItem"}}
      }
    },
    "items": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/lifecycleItem"}},
    "sessions": {"type": "array", "items": {"$ref": "#/$defs/session"}},
    "scheduled_reanalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_completed"],
      "properties": {
        "last_completed": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["reviewed_count", "operation_id", "completed_at"],
              "properties": {
                "reviewed_count": {"type": "integer", "minimum": 0},
                "operation_id": {"type": "string", "minLength": 36, "maxLength": 36},
                "completed_at": {"type": "string", "minLength": 1}
              }
            }
          ]
        }
      }
    }
  }
}
