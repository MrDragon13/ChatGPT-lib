{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatgpt-lib.local/schemas/collection.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "entity_type", "name_ru", "name_original", "member_ids"],
  "properties": {
    "schema_version": {"const": 4},
    "id": {"type": "string", "minLength": 1},
    "entity_type": {"const": "collection"},
    "name_ru": {"type": "string", "minLength": 1},
    "name_original": {"type": "string", "minLength": 1},
    "member_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "viewer_signals": {
      "type": "object",
      "patternProperties": {"^[a-z][a-z0-9_-]*$": {"$ref": "https://chatgpt-lib.local/schemas/common.schema.json#/$defs/viewerSignal"}},
      "additionalProperties": false
    },
    "group_signals": {
      "type": "object",
      "patternProperties": {"^[a-z][a-z0-9_-]*$": {"$ref": "https://chatgpt-lib.local/schemas/common.schema.json#/$defs/groupSignal"}},
      "additionalProperties": false
    },
    "target_states": {
      "type": "object",
      "patternProperties": {"^[a-z][a-z0-9_-]*$": {"$ref": "https://chatgpt-lib.local/schemas/common.schema.json#/$defs/targetState"}},
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"created_at": {"type": ["string", "null"]}, "updated_at": {"type": ["string", "null"]}}
    }
  }
}
