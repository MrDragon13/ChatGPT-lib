{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatgpt-lib.local/commands/reserve_reassessment_session.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "operation",
    "pilot_id",
    "session_id",
    "work_ids",
    "expected_ledger_digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "operation_id": {"type": "string", "minLength": 36, "maxLength": 36},
    "operation": {"const": "reserve_reassessment_session"},
    "pilot_id": {"const": "primary-legacy-v1"},
    "session_id": {"type": "string", "minLength": 36, "maxLength": 36},
    "work_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "expected_ledger_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
