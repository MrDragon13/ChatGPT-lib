{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatgpt-lib.local/commands/complete_reassessment_item.schema.json",
  "$defs": {
    "historicalExposure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timing", "before_finalization"],
      "properties": {
        "timing": {"enum": ["none", "before_initial_response", "after_initial_response"]},
        "before_finalization": {"type": "boolean"}
      }
    },
    "feedbackEdit": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{"required": ["set"]}, {"required": ["clear"]}],
      "properties": {
        "set": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "viewing": {"$ref": "https://chatgpt-lib.local/commands/common.schema.json#/$defs/viewing"},
            "rating": {"$ref": "https://chatgpt-lib.local/commands/common.schema.json#/$defs/rating"},
            "reaction": {"$ref": "https://chatgpt-lib.local/commands/common.schema.json#/$defs/reaction"},
            "feedback": {"$ref": "https://chatgpt-lib.local/commands/common.schema.json#/$defs/feedback"}
          }
        },
        "clear": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["viewing", "rating", "reaction", "feedback"]}
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "operation",
    "pilot_id",
    "session_id",
    "work_id",
    "expected_ledger_digest",
    "outcome"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "operation_id": {"type": "string", "minLength": 36, "maxLength": 36},
    "operation": {"const": "complete_reassessment_item"},
    "pilot_id": {"const": "primary-legacy-v1"},
    "session_id": {"type": "string", "minLength": 36, "maxLength": 36},
    "work_id": {"type": "string", "minLength": 1},
    "expected_ledger_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "outcome": {"enum": ["changed", "confirmed_unchanged", "deferred"]},
    "historical_exposure": {"$ref": "#/$defs/historicalExposure"},
    "feedback_edit": {"$ref": "#/$defs/feedbackEdit"}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "changed"}}, "required": ["outcome"]},
      "then": {"required": ["historical_exposure", "feedback_edit"]}
    },
    {
      "if": {"properties": {"outcome": {"const": "confirmed_unchanged"}}, "required": ["outcome"]},
      "then": {
        "required": ["historical_exposure"],
        "not": {"required": ["feedback_edit"]}
      }
    },
    {
      "if": {"properties": {"outcome": {"const": "deferred"}}, "required": ["outcome"]},
      "then": {
        "not": {
          "anyOf": [
            {"required": ["historical_exposure"]},
            {"required": ["feedback_edit"]}
          ]
        }
      }
    }
  ]
}
